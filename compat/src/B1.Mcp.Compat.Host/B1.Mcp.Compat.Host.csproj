<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\B1.Mcp.Compat.Core\B1.Mcp.Compat.Core.csproj" />
    <ProjectReference Include="..\B1.Mcp.Compat.Data\B1.Mcp.Compat.Data.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded knowledge base (see README). -->
    <EmbeddedResource Include="Resources\kb-*.json.gz" LogicalName="%(Filename)%(Extension)" />
    <!-- Embedded extended read packages, one per exact build (read-<package>.json.gz; see rea/19). -->
    <EmbeddedResource Include="Resources\read-*.json.gz" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
  </ItemGroup>

</Project>
