{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": { "FormatterName": "simple", "FormatterOptions": { "TimestampFormat": "HH:mm:ss.fff ", "SingleLine": true } }
  },
  "AllowedHosts": "*",
  "Compat": {
    "Listen": "https://localhost:50100",
    "Upstream": { "Url": "https://localhost:50000", "SkipTlsVerify": true },
    "Database": {
      "Provider": "SqlServer",
      "ConnectionString": "Server=localhost;Integrated Security=true;TrustServerCertificate=true;Initial Catalog={CompanyDB}"
    },
    "KnowledgeBase": { "OverridePath": "" },
    "Mappings": { "OverridePath": "mappings.override.json" },
    "SimulateLegacy": false
  }
}
